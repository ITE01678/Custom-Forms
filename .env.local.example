# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real IDs/secrets (though note: this
# app has no server-held secrets at all, by design — see SETUP.md).
#
# IMPORTANT: this .example file itself DOES get committed — never fill in
# real values here. Put real values only in .env.local (gitignored) and in
# the GitHub Actions repo Variables used by .github/workflows/deploy.yml.

# --- Azure App Registration ("Custom Forms" — dedicated, not shared with
#     the Employee Portal or opsquest) ---
# Azure Portal -> App registrations -> Custom Forms -> Overview
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
# Must match a redirect URI registered on the App Registration's SPA platform.
VITE_REDIRECT_URI=http://localhost:5173

# Org domain allowed to use the app (defense-in-depth alongside restricting
# the Enterprise Application's assignment to an internal security group).
VITE_ALLOWED_DOMAIN=jil-jupiter.com

# --- SharePoint site holding this app's Lists/libraries (see SETUP.md) ---
# Doesn't have to be named "Forms" — point these at whatever SharePoint site
# you're dedicating to this app.
VITE_SHAREPOINT_HOSTNAME=jupiterkolkata.sharepoint.com
# Path ONLY — no protocol, no hostname. Graph builds the lookup as
# /sites/{HOSTNAME}:{SITE_PATH}, so a full URL here breaks site resolution.
#   right: /sites/Forms
#   wrong: https://jupiterkolkata.sharepoint.com/sites/Forms
VITE_SHAREPOINT_SITE_PATH=/sites/Forms
